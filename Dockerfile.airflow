FROM apache/airflow:2.9.2-python3.11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
USER airflow
# Install extra packages under the Airflow 2.9.2 constraint file so pip cannot
# upgrade (or uninstall) any package that Airflow itself depends on.
RUN pip install --no-cache-dir \
    apache-airflow-providers-databricks \
    databricks-sql-connector \
    databricks-sdk \
    pandas \
    pyarrow \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.2/constraints-3.11.txt"
# great-expectations may not resolve under the Airflow constraint file; install
# best-effort — pipeline/validate_export.py falls back to pandas checks without it.
RUN pip install --no-cache-dir great-expectations \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.9.2/constraints-3.11.txt" \
    || echo "great-expectations skipped (constraint conflict) — validate_export uses pandas fallback"
